# SVRMON24 environment template — copy to .env and fill in values.
# Placeholders only. Do not put real secrets in this file.
# Never commit a real .env.

# Application
APP_NAME=SVRMON24
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8200
LOG_LEVEL=INFO

# --- Authentication (Master Phase 3+) ---
# Production-oriented defaults: OIDC on when configured; Basic OFF.
# BASIC_AUTH_ENABLED must never bypass tenant isolation (scoped to migration tenant).
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USERNAME=change-me
BASIC_AUTH_PASSWORD=change-me

# Provider-neutral OIDC (Authorization Code + PKCE). Entra ID / Keycloak compatible.
OIDC_ENABLED=false
# Issuer URL without trailing path quirks — examples:
#   Keycloak: http://localhost:8080/realms/svrmon24
#   Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8200/auth/callback
OIDC_SCOPES=openid profile email

# Signed server session cookie (required for OIDC login state + session)
SESSION_SECRET=change-me-session-secret
SESSION_COOKIE_NAME=svrmon24_session
SESSION_MAX_AGE_SECONDS=28800
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax

# MongoDB (PyMongo). Connection errors are handled gracefully at runtime.
# Shared DB with mandatory tenant_id scoping (Master Phase 5 hard isolation).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=svrmon24
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# --- Tenancy (Phase 5–8) + custom entity tables (0.18.0) + inventory custom columns (0.19.0) + field edit/scroll (0.20.0) + custom-tables UX (0.21.0) + dropdown open-list fix (0.22.0) ---
# Migration tenant is seeded on startup (idempotent):
#   tenant_id=tenant-svrmon24-legacy  display_name=SVRMON24 Legacy
# Null/missing tenant_id rows are backfilled on startup (or via script):
#   python scripts/ensure_migration_tenant.py
#   python scripts/backfill_tenant_id.py
# Typed CMDB migrate (legacy components → cmdb_servers/network/middleware/databases/applications):
#   python scripts/migrate_components_to_typed.py
#   python scripts/migrate_components_to_typed.py --remove-legacy   # after verification only
# Field definitions migrate (custom_field_definitions → cmdb_field_definitions + built-in OS/product):
#   python scripts/migrate_custom_fields_to_cmdb.py
#   python scripts/migrate_custom_fields_to_cmdb.py --remove-legacy   # after verification only
# Column configurations (cmdb_column_configurations) — tenant-scoped Inventory/Relationships grids:
#   GET/PUT/DELETE /api/column-configurations/{inventory|relationships}
#   Inventory catalog merges active custom field definitions as toggleable columns (0.19.0)
#   Custom field Edit UI + PUT /api/custom-fields/{key}; wide tables scroll horizontally (0.20.0)
# Custom entity tables:
#   cmdb_custom_table_definitions + cmdb_custom_records (single data collection, table_key)
#   GET/POST /api/custom-tables · /api/custom-tables/{key}/records · GET /api/entity-refs
#   Edit defs/columns via PUT; dropdown labels = display name + table_key; help balloons (0.21.0)
#   Open dropdown blank-option fix: color-scheme light + .combo-select ink-on-white menus (0.22.0)
#   Combo collapse + column form spacing + optional reference target (0.23.0)
# Platform admin is CLI-only — never auto-granted on first OIDC login:
#   python scripts/bootstrap_platform_admin.py --username operator --email ops@example.com
# Optional OIDC link for the operator:
#   ... --oidc-issuer <issuer> --oidc-subject <sub>
# Org switcher remains disabled; isolation_enforced=true on CMDB APIs.

# Local Ollama for AI diagnostic analysis (Master Phase 12).
# Disabled unless explicitly enabled. No external/cloud model providers.
# When disabled, limited by entitlements, or unavailable → rule-based fallback.
# Shared-local contention: one Ollama host serves all tenants (GPU/CPU queueing).
OLLAMA_ENABLED=false
OLLAMA_URL=http://localhost:11434
# OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
# Tenant plan limit max_ollama_analyses (default unlimited) caps stored Ollama analyses.
